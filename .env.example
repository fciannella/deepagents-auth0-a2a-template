# Create your own Auth0 SPA application and API. No confidential client secret in the UI.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=configure-me
AUTH0_AUDIENCE=https://your-agent.example/api
AUTH0_REQUIRED_SCOPES=agent:chat
PUBLIC_ORIGIN=http://localhost:9183
AUTH0_REDIRECT_URI=http://localhost:9183
# Extra browser client origins, in JSON; server-to-server clients do not need CORS.
CORS_ORIGINS=[]

AGENT_ID=generic-assistant
AGENT_NAME=Deep Agent
AGENT_DESCRIPTION=A configurable text assistant.
AGENT_VERSION=0.1.0
# OpenRouter is the example provider. Any compatible ChatOpenAI endpoint can be configured.
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=google/gemini-3.1-flash-lite
MODEL_API_KEY=
DATA_DIR=data
